//// Generated by margot, do not edit.

import gleam/string

pub type Locale {
  De
  DeFr
  En
  EnFr
  Fr
  FrFr
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case detect_locale_() {
    "de-fr" -> DeFr
    "en-fr" -> EnFr
    "fr-fr" -> FrFr
    tag ->
      case string.split(tag, "-") {
        ["de", ..] -> De
        ["en", ..] -> En
        ["fr", ..] -> Fr
        _ -> En
      }
  }
}

pub fn title(locale_: Locale) -> String {
  case locale_ {
    De -> "Titel"
    DeFr | EnFr | FrFr -> "Titre de France"
    En -> "Title"
    Fr -> "Titre"
  }
}

