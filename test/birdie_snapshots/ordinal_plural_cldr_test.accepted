@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case string.split(detect_locale_(), "-") {
    ["ar", ..] -> Ar
    ["cs", ..] -> Cs
    ["de", ..] -> De
    ["en", ..] -> En
    ["es", ..] -> Es
    ["fr", ..] -> Fr
    ["he", ..] -> He
    ["id", ..] -> Id
    ["it", ..] -> It
    ["ja", ..] -> Ja
    ["ko", ..] -> Ko
    ["ms", ..] -> Ms
    ["pl", ..] -> Pl
    ["pt", ..] -> Pt
    ["ru", ..] -> Ru
    ["sv", ..] -> Sv
    ["th", ..] -> Th
    ["uk", ..] -> Uk
    ["vi", ..] -> Vi
    ["zh", ..] -> Zh
    _ -> En
  }
}

pub fn place(locale_: Locale, rank rank: Int) -> String {
  case locale_ {
    Ar | Cs | De | Es | He | Id | Ja | Ko | Pl | Pt | Ru | Th | Zh -> "other"
    En ->
      case rank {
        _ if rank % 10 == 1 && rank % 100 != 11 -> "one"
        _ if rank % 10 == 2 && rank % 100 != 12 -> "two"
        _ if rank % 10 == 3 && rank % 100 != 13 -> "few"
        _ -> "other"
      }
    Fr | Ms | Vi ->
      case rank {
        1 -> "one"
        _ -> "other"
      }
    It ->
      case rank {
        8 | 11 | 80 | 800 -> "many"
        _ -> "other"
      }
    Sv ->
      case rank {
        _
          if rank % 10 == 1
          && rank % 100 != 11
          || rank % 10 == 2
          && rank % 100 != 12
        -> "one"
        _ -> "other"
      }
    Uk ->
      case rank {
        _ if rank % 10 == 3 && rank % 100 != 13 -> "few"
        _ -> "other"
      }
  }
}

