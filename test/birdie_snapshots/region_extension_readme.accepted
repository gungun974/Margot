//// Generated by margot, do not edit.

import gleam/string

pub type Locale {
  En
  EnGb
  EnUs
  Fr
  FrCa
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case detect_locale_() {
    "en-gb" -> EnGb
    "en-us" -> EnUs
    "fr-ca" -> FrCa
    tag ->
      case string.split(tag, "-") {
        ["en", ..] -> En
        ["fr", ..] -> Fr
        _ -> En
      }
  }
}

pub fn save(locale_: Locale) -> String {
  case locale_ {
    En | EnGb | EnUs -> "Save"
    Fr -> "Enregistrer"
    FrCa -> "Sauvegarder"
  }
}

pub fn cancel(locale_: Locale) -> String {
  case locale_ {
    En -> "Cancel"
    EnGb -> "Cancel, mate"
    EnUs -> "Cancel, buddy"
    Fr | FrCa -> "Annuler"
  }
}

