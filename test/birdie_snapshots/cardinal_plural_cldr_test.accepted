pub fn day(locale_: Locale, day_count day_count: Int) -> String {
  case locale_ {
    Ar ->
      case day_count {
        0 -> "zero"
        1 -> "one"
        2 -> "two"
        _ if day_count % 100 >= 3 && day_count % 100 <= 10 -> "few"
        _ if day_count % 100 >= 11 -> "many"
        _ -> "other"
      }
    Cs ->
      case day_count {
        0 -> "zero"
        1 -> "one"
        2 | 3 | 4 -> "few"
        _ -> "other"
      }
    De | En | Sv ->
      case day_count {
        0 -> "zero"
        1 -> "one"
        _ -> "other"
      }
    Es | It ->
      case day_count {
        0 -> "zero"
        1 -> "one"
        _ if day_count != 0 && day_count % 1_000_000 == 0 -> "many"
        _ -> "other"
      }
    Fr | Pt ->
      case day_count {
        0 | 1 -> "one"
        _ if day_count != 0 && day_count % 1_000_000 == 0 -> "many"
        _ -> "other"
      }
    He ->
      case day_count {
        0 -> "zero"
        1 -> "one"
        2 -> "two"
        _ -> "other"
      }
    Id | Ja | Ko | Ms | Th | Vi | Zh -> "other"
    Pl ->
      case day_count {
        1 -> "one"
        _
          if day_count % 10 >= 2
          && day_count % 10 <= 4
          && day_count % 100 < 12
          || day_count % 10 >= 2
          && day_count % 10 <= 4
          && day_count % 100 > 14
        -> "few"
        _
          if day_count != 1
          && day_count % 10 <= 1
          || day_count % 10 >= 5
          && day_count % 10 <= 9
          || day_count % 100 >= 12
          && day_count % 100 <= 14
        -> "many"
        _ -> "other"
      }
    Ru | Uk ->
      case day_count {
        _ if day_count % 10 == 1 && day_count % 100 != 11 -> "one"
        _
          if day_count % 10 >= 2
          && day_count % 10 <= 4
          && day_count % 100 < 12
          || day_count % 10 >= 2
          && day_count % 10 <= 4
          && day_count % 100 > 14
        -> "few"
        _
          if day_count % 10 == 0
          || day_count % 10 >= 5
          && day_count % 10 <= 9
          || day_count % 100 >= 11
          && day_count % 100 <= 14
        -> "many"
        _ -> "other"
      }
  }
