//// Generated by margot, do not edit.

import gleam/int
import gleam/string

pub type Locale {
  En
  Fr
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case string.split(detect_locale_(), "-") {
    ["en", ..] -> En
    ["fr", ..] -> Fr
    _ -> En
  }
}

pub fn home__title(locale_: Locale) -> String {
  case locale_ {
    En -> "Welcome back!"
    Fr -> "Bon retour !"
  }
}

pub fn home__greeting(locale_: Locale, name name: String) -> String {
  case locale_ {
    En -> "Hello " <> name
    Fr -> "Bonjour " <> name
  }
}

pub fn home__unread_messages(locale_: Locale, n n: Int) -> String {
  case locale_ {
    En ->
      case n {
        1 -> "You have " <> int.to_string(n) <> " unread message"
        _ -> "You have " <> int.to_string(n) <> " unread messages"
      }
    Fr ->
      case n {
        0 | 1 -> "Vous avez " <> int.to_string(n) <> " message non lu"
        _ -> "Vous avez " <> int.to_string(n) <> " messages non lus"
      }
  }
}

pub fn buttons__save(locale_: Locale) -> String {
  case locale_ {
    En -> "Save"
    Fr -> "Enregistrer"
  }
}

pub fn buttons__cancel(locale_: Locale) -> String {
  case locale_ {
    En -> "Cancel"
    Fr -> "Annuler"
  }
}

