//// Generated by margot, do not edit.

import gleam/string

pub type Locale {
  De
  DeFr
  En
  EnFr
  Fr
  FrFr
  Ja
  JaFr
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case detect_locale_() {
    "de-fr" -> DeFr
    "en-fr" -> EnFr
    "fr-fr" -> FrFr
    "ja-fr" -> JaFr
    tag ->
      case string.split(tag, "-") {
        ["de", ..] -> De
        ["en", ..] -> En
        ["fr", ..] -> Fr
        ["ja", ..] -> Ja
        _ -> En
      }
  }
}

pub fn title(locale_: Locale) -> String {
  case locale_ {
    De -> "Titel"
    DeFr | EnFr | FrFr | JaFr -> "Titre de France"
    En | Ja -> "Title"
    Fr -> "Titre"
  }
}

pub fn subtitle(locale_: Locale) -> String {
  case locale_ {
    De | Fr | Ja -> "Untertitel"
    DeFr | EnFr | FrFr | JaFr -> "Sous-titre de France"
    En -> "Subtitle"
  }
}

