import gleam/int
import gleam/string

pub type Locale {
  En
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case string.split(detect_locale_(), "-") {
    ["en", ..] -> En
    _ -> En
  }
}

pub fn playlist_track_count(
  locale_: Locale,
  n n: Int,
  name name: String,
) -> String {
  case locale_ {
    En ->
      case n {
        0 -> "There are no tracks."
        1 -> "\"" <> name <> "\" has one track."
        _ -> "There are " <> int.to_string(n) <> " tracks."
      }
  }
}

