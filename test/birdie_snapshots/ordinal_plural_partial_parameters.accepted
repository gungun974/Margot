import gleam/int
import gleam/string

pub type Locale {
  En
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case string.split(detect_locale_(), "-") {
    ["en", ..] -> En
    _ -> En
  }
}

pub fn runner_place(locale_: Locale, n n: Int, name name: String) -> String {
  case locale_ {
    En ->
      case n {
        _ if n % 10 == 1 && n % 100 != 11 -> "\"" <> name <> "\" won."
        _ if n % 10 == 2 && n % 100 != 12 -> "Second place."
        _ if n % 10 == 3 && n % 100 != 13 -> "Third place."
        _ -> int.to_string(n) <> "th place."
      }
  }
}

