//// Generated by margot, do not edit.

pub type Locale {
  ArEg
  EnGb
  FrCa
  PlPl
  PtPt
  RuRu
  ZhHantTw
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case detect_locale_() {
    "ar-eg" -> ArEg
    "en-gb" -> EnGb
    "fr-ca" -> FrCa
    "pl-pl" -> PlPl
    "pt-pt" -> PtPt
    "ru-ru" -> RuRu
    "zh-hant-tw" -> ZhHantTw
    _ -> ArEg
  }
}

pub fn day(locale_: Locale, day_count day_count: Int) -> String {
  case locale_ {
    ArEg ->
      case day_count {
        0 -> "zero"
        1 -> "one"
        2 -> "two"
        _ if day_count % 100 >= 3 && day_count % 100 <= 10 -> "few"
        _ if day_count % 100 >= 11 -> "many"
        _ -> "other"
      }
    EnGb ->
      case day_count {
        0 -> "zero"
        1 -> "one"
        _ -> "other"
      }
    FrCa | PtPt ->
      case day_count {
        0 | 1 -> "one"
        _ if day_count != 0 && day_count % 1_000_000 == 0 -> "many"
        _ -> "other"
      }
    PlPl ->
      case day_count {
        1 -> "one"
        _
          if day_count % 10 >= 2
          && day_count % 10 <= 4
          && day_count % 100 < 12
          || day_count % 10 >= 2
          && day_count % 10 <= 4
          && day_count % 100 > 14
        -> "few"
        _
          if day_count != 1
          && day_count % 10 <= 1
          || day_count % 10 >= 5
          && day_count % 10 <= 9
          || day_count % 100 >= 12
          && day_count % 100 <= 14
        -> "many"
        _ -> "other"
      }
    RuRu ->
      case day_count {
        _ if day_count % 10 == 1 && day_count % 100 != 11 -> "one"
        _
          if day_count % 10 >= 2
          && day_count % 10 <= 4
          && day_count % 100 < 12
          || day_count % 10 >= 2
          && day_count % 10 <= 4
          && day_count % 100 > 14
        -> "few"
        _
          if day_count % 10 == 0
          || day_count % 10 >= 5
          && day_count % 10 <= 9
          || day_count % 100 >= 11
          && day_count % 100 <= 14
        -> "many"
        _ -> "other"
      }
    ZhHantTw -> "other"
  }
}

