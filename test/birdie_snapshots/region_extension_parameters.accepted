import gleam/int
import gleam/string

pub type Locale {
  En
  EnGb
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case detect_locale_() {
    "en-gb" -> EnGb
    tag ->
      case string.split(tag, "-") {
        ["en", ..] -> En
        _ -> En
      }
  }
}

pub fn greeting(locale_: Locale, name name: String) -> String {
  case locale_ {
    En -> "Hello " <> name
    EnGb -> "Hello " <> name <> ", mate"
  }
}

pub fn unread_messages(locale_: Locale, n n: Int) -> String {
  case locale_ {
    En | EnGb ->
      case n {
        1 -> "You have " <> int.to_string(n) <> " unread message"
        _ -> "You have " <> int.to_string(n) <> " unread messages"
      }
  }
}

