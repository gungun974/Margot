//// Generated by margot, do not edit.

import gleam/int
import gleam/string

pub type Locale {
  En
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case string.split(detect_locale_(), "-") {
    ["en", ..] -> En
    _ -> En
  }
}

pub fn apple(locale_: Locale, type_ type_: Int) -> String {
  case locale_ {
    En ->
      case type_ {
        1 -> "I have " <> int.to_string(type_) <> " apple."
        _ -> "I have " <> int.to_string(type_) <> " apples."
      }
  }
}

