//// Generated by margot, do not edit.

import gleam/float
import gleam/int
import gleam/string

pub type Locale {
  En
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case string.split(detect_locale_(), "-") {
    ["en", ..] -> En
    _ -> En
  }
}

pub fn greet(
  locale_: Locale,
  locale locale: String,
  int int: Int,
  float float: Float,
) -> String {
  case locale_ {
    En ->
      locale
      <> " has "
      <> int.to_string(int)
      <> " and "
      <> float.to_string(float)
  }
}

