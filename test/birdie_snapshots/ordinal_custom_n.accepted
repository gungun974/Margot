import gleam/int
import gleam/string

pub type Locale {
  En
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case string.split(detect_locale_(), "-") {
    ["en", ..] -> En
    _ -> En
  }
}

pub fn place(locale_: Locale, rank rank: Int) -> String {
  case locale_ {
    En ->
      case rank {
        _ if rank % 10 == 1 && rank % 100 != 11 ->
          int.to_string(rank) <> "st place."
        _ if rank % 10 == 2 && rank % 100 != 12 ->
          int.to_string(rank) <> "nd place."
        _ if rank % 10 == 3 && rank % 100 != 13 ->
          int.to_string(rank) <> "rd place."
        _ -> int.to_string(rank) <> "th place."
      }
  }
}

