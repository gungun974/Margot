import gleam/string

pub type Locale {
  De
  En
  Fr
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case string.split(detect_locale_(), "-") {
    ["de", ..] -> De
    ["en", ..] -> En
    ["fr", ..] -> Fr
    _ -> En
  }
}

pub fn first(locale_: Locale) -> String {
  case locale_ {
    De -> "de first"
    En -> "en first"
    Fr -> "codes first"
  }
}

pub fn second(locale_: Locale) -> String {
  case locale_ {
    De | Fr -> "codes second"
    En -> "en second"
  }
}

pub fn third(locale_: Locale) -> String {
  case locale_ {
    De | Fr -> "any third"
    En -> "en third"
  }
}

