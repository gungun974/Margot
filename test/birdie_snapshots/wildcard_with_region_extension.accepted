import gleam/string

pub type Locale {
  En
  EnCa
  Fr
  FrCa
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case detect_locale_() {
    "en-ca" -> EnCa
    "fr-ca" -> FrCa
    tag ->
      case string.split(tag, "-") {
        ["en", ..] -> En
        ["fr", ..] -> Fr
        _ -> En
      }
  }
}

pub fn save(locale_: Locale) -> String {
  case locale_ {
    En -> "Save"
    EnCa | FrCa -> "Save, eh"
    Fr -> "Enregistrer"
  }
}

pub fn cancel(locale_: Locale) -> String {
  case locale_ {
    En | EnCa -> "Cancel"
    Fr | FrCa -> "Annuler"
  }
}

