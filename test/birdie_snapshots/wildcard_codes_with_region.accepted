import gleam/string

pub type Locale {
  De
  En
  EnGb
  FrFr
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case detect_locale_() {
    "en-gb" -> EnGb
    "fr-fr" -> FrFr
    tag ->
      case string.split(tag, "-") {
        ["de", ..] -> De
        ["en", ..] -> En
        _ -> En
      }
  }
}

pub fn title(locale_: Locale) -> String {
  case locale_ {
    De | EnGb | FrFr -> "Titre"
    En -> "Title"
  }
}

