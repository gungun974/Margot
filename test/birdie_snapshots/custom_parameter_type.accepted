//// Generated by margot, do not edit.

import gleam/int
import gleam/string

pub type Locale {
  En
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case string.split(detect_locale_(), "-") {
    ["en", ..] -> En
    _ -> En
  }
}

pub fn greet(locale_: Locale, name name: String, age age: Int) -> String {
  case locale_ {
    En -> "Hello " <> name <> ", you are " <> int.to_string(age) <> " years old"
  }
}

