//// Generated by margot, do not edit.

import gleam/string

pub type Locale {
  De
  Fr
  FrCa
}

@external(javascript, "./t_ffi.mjs", "detect_locale")
fn detect_locale_() -> String {
  ""
}

pub fn auto_() -> Locale {
  case detect_locale_() {
    "fr-ca" -> FrCa
    tag ->
      case string.split(tag, "-") {
        ["de", ..] -> De
        ["fr", ..] -> Fr
        _ -> De
      }
  }
}

pub fn save(locale_: Locale) -> String {
  case locale_ {
    De -> "Speichern"
    Fr -> "Enregistrer"
    FrCa -> "Sauvegarder"
  }
}

pub fn cancel(locale_: Locale) -> String {
  case locale_ {
    De -> "Abbrechen"
    Fr | FrCa -> "Annuler"
  }
}

